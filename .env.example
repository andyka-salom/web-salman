APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file


BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

DB_CACHE_ENABLED=
DB_CACHE_TTL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Driver for the "public" disk (user uploads): 'local' or 's3'.
# Set to 's3' to store & serve all uploads from Biznet NEO Object Storage.
FILESYSTEM_PUBLIC_DRIVER=local
QUEUE_CONNECTION=database

# Cache & Session
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Biznet GIO NEO Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=idn
AWS_BUCKET=
# Public base URL of objects, e.g. https://nos.wjv-1.neo.id/<bucket>
AWS_URL=
# S3 API endpoint, e.g. https://nos.wjv-1.neo.id
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"


# Fonnte WhatsApp API
FONNTE_TOKEN=
FONNTE_API_URL=

# Auth Configuration
AUTH_PASSWORD_RESET_TOKEN_EXPIRY=
EMAIL_VERIFICATION_REQUIRED=

# Security
SANCTUM_STATEFUL_DOMAINS=
